+
+// ============================================================================
+// Screen-share toggle wiring (companion mode)
+// ============================================================================
+(function() {
+    const sb = document.getElementById("screenShareBtn");
+    if (!sb) return;
+    let last = 0;
+    function handler(e) {
+        e.preventDefault();
+        if (Date.now() - last < 500) return;
+        last = Date.now();
+        const provider = (typeof media !== "undefined" && media instanceof LiveMediaProvider) ? media
+            : (typeof cameraPreview !== "undefined" && cameraPreview && cameraPreview._previewing) ? cameraPreview : null;
+        if (!provider) { addSystemEntry("请先开始预览或会话"); return; }
+        const target = provider._videoSource === "screen" ? "camera" : "screen";
+        provider.switchVideoSource(target).catch(err => addSystemEntry(`Switch failed: ${err.message}`));
+    }
+    sb.addEventListener("click", handler);
+    sb.addEventListener("touchend", handler, { passive: false });
+})();
