+"""Silero VAD wrapper for route D.
+
+精简版：单 VAD + 1024 samples 滑窗，输入 16kHz float32 PCM。
+每个 audio_chunk (1s = 16000 samples) 切成 15-16 个 1024 windows，
+计算 mean speech probability，超过阈值 → 用户在说话。
+
+参考: spark_704:/home/LChuang/workspace/MiniCPM-V-CookBook/demo/web_demo/WebRTC_Demo/
+       omini_backend_code/code/voice_chat/vad/vad_utils.py
+"""
+
+import logging
+import os
+import threading
+from typing import Optional
+
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+_DEFAULT_ONNX_PATH = os.path.join(os.path.dirname(__file__), "silero_vad.onnx")
+
+
+class SileroVAD:
+    """Silero VAD ONNX wrapper, thread-safe via state lock.
+
+    Usage:
+        vad = SileroVAD()
+        prob = vad.detect(audio_chunk_16khz_float32)  # returns 0-1 speech probability
+    """
+
+    WINDOW_SIZE = 1024  # samples @ 16kHz = 64ms
+    SAMPLE_RATE = 16000
+
+    def __init__(self, onnx_path: Optional[str] = None):
+        try:
+            import onnxruntime
+        except ImportError as e:
+            raise RuntimeError(
+                "SileroVAD requires onnxruntime. pip install onnxruntime"
+            ) from e
+
+        path = onnx_path or _DEFAULT_ONNX_PATH
+        if not os.path.exists(path):
+            raise FileNotFoundError(f"silero_vad.onnx not found at {path}")
+
+        opts = onnxruntime.SessionOptions()
+        opts.inter_op_num_threads = 1
+        opts.intra_op_num_threads = 1
+        opts.log_severity_level = 4
+        self.session = onnxruntime.InferenceSession(
+            path, providers=["CPUExecutionProvider"], sess_options=opts
+        )
+        # Persistent LSTM state across chunks
+        self._h = np.zeros((2, 1, 64), dtype=np.float32)
+        self._c = np.zeros((2, 1, 64), dtype=np.float32)
+        self._lock = threading.Lock()
+        logger.info(f"SileroVAD loaded from {path}")
+
+    def reset_state(self):
+        """Reset LSTM state, call between sessions."""
+        with self._lock:
+            self._h.fill(0.0)
+            self._c.fill(0.0)
+
+    def detect_window(self, window: np.ndarray) -> float:
+        """Run VAD on one 1024-sample window @ 16kHz, return speech prob 0-1."""
+        if window.shape[-1] != self.WINDOW_SIZE:
+            raise ValueError(f"expected window {self.WINDOW_SIZE} samples, got {window.shape}")
+        x = window.astype(np.float32).reshape(1, -1)
+        with self._lock:
+            out, h, c = self.session.run(
+                None,
+                {
+                    "input": x,
+                    "h": self._h,
+                    "c": self._c,
+                    "sr": np.array(self.SAMPLE_RATE, dtype="int64"),
+                },
+            )
+            self._h, self._c = h, c
+        return float(out[0, 0])
+
+    def detect_chunk(self, audio: np.ndarray) -> float:
+        """Run VAD on a multi-window chunk (e.g. 1s = 16 windows @ 1024).
+
+        Returns mean speech probability across windows in the chunk.
+        Frames shorter than WINDOW_SIZE are zero-padded; trailing partial window dropped.
+        """
+        audio = np.asarray(audio, dtype=np.float32).flatten()
+        n_windows = len(audio) // self.WINDOW_SIZE
+        if n_windows == 0:
+            return 0.0
+        probs = []
+        for i in range(n_windows):
+            start = i * self.WINDOW_SIZE
+            window = audio[start : start + self.WINDOW_SIZE]
+            probs.append(self.detect_window(window))
+        return float(np.mean(probs))
+
+
+_global_vad: Optional[SileroVAD] = None
+
+
+def get_vad() -> SileroVAD:
+    """Lazy-init global VAD singleton."""
+    global _global_vad
+    if _global_vad is None:
+        _global_vad = SileroVAD()
+    return _global_vad
